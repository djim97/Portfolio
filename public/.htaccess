# Portfolio Angular - reecriture des routes vers index.html
# Ce fichier est copie automatiquement dans dist/ au build (dossier public/).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Ne jamais reecrire l'API PHP existante
  RewriteRule ^php/ - [L]

  # Un fichier ou un dossier reel est servi tel quel
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Tout le reste part sur index.html (routing Angular)
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
